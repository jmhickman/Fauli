<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Warnings -->
    <WarningsAsErrors>warning;$(WarningsAsErrors)</WarningsAsErrors>
    <NoWarn>$(NoWarn);FS0025</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="KerberosInternalsTests.fs" />
    <Compile Include="KerberosPureTests.fs" />
    <Compile Include="NtlmTests.fs" />
    <Compile Include="TicketIngestionTests.fs" />
    <Compile Include="SmbSigningTests.fs" />
    <Compile Include="ServiceDiscoveryTests.fs" />
    <Compile Include="LdapWireTests.fs" />
    <Compile Include="LdapTlsTests.fs" />
    <Compile Include="SolverPureTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Fauli.fsproj" />
  </ItemGroup>

</Project>
